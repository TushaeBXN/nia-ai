# RunPod Serverless endpoint — copy from your endpoint's page in the RunPod console
# Format: https://api.runpod.io/v2/<endpoint-id>
RUNPOD_ENDPOINT_URL=https://api.runpod.io/v2/YOUR_ENDPOINT_ID

# RunPod API key — Settings > API Keys in the RunPod console
RUNPOD_API_KEY=your_runpod_api_key_here

# Lock this to your frontend domain in production (e.g. https://nia.example.com)
# Leave * for local testing only
ALLOWED_ORIGIN=*

# Port (Render sets this automatically — leave as-is)
PORT=3001

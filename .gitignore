# Training data — too large for git, keep locally
training_data/*.jsonl
training_data/*.txt

# Keep the build state so resume works after cloning
!training_data/nia_build_state.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/
.env

# macOS
.DS_Store

# PRIVACY: session case files must never be committed
coordination/shared/*
!coordination/shared/.gitkeep

# Checkpoints
checkpoints/
*.safetensors
*.bin
*.pt
*.pth

# Voice models (too large for GitHub's 100MB limit)
voices/*.onnx
voices/*.onnx.json

# Logs
*.log
wandb/
runs/

# Runtime state — never commit session/memory data
nia_state.json
nia_memory.db
